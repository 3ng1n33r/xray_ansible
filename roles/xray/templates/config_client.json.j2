{
    "log": {
        "loglevel": "warning"
    },
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {   
                "type": "field",
                "ip": [
                    "geoip:ru",
                    "geoip:private"
                ],
                "outboundTag": "direct"
            },
            {   
                "type": "field",
                "domain": [
                    "regexp:.*\\.ru$",
                    "geosite:reddit",
                    "geosite:mailru-group",
                    "geosite:yandex",
                    "geosite:category-gov-ru"
                ],
                "outboundTag": "direct"
            }
        ]
    },
    "inbounds": [
        {
            "listen": "127.0.0.1",
            "port": 1080,
            "protocol": "socks",
            "settings": {
                "udp": true
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "routeOnly": true
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "{{ ansible_default_ipv4.address }}",
                        "port": "{{ xray_port }}",
                        "users": [
                            {
                                "id": "{{ uuid_files.results[item|int].stdout }}",
                                "encryption": "none"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "xhttp",
                "security": "reality",
                "xhttpSettings": {
                    "path": "/x1",
                    "extra": {
                    "xmux": {
                        "maxConcurrency": 128,
                        "cMaxReuseTimes": 0,
                        "hMaxReusableSecs": 7200
                        }              
                    }
                },
                "realitySettings": {
                    "fingerprint": "chrome",
                    "serverName": "{{ xray_realityDomain }}",
                    "publicKey": "{{ publicKey.stdout }}",
                    "spiderX": "/",
                    "shortId": "{{ shortId.stdout }}"
                }
            },
            "tag": "proxy"
        },
        {
            "protocol": "freedom",
            "tag": "direct"
        }
    ]
}