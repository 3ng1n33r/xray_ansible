[Unit]
Description=Xray Service
Documentation=https://github.com/xtls
After=network.target nss-lookup.target

[Service]
Type=simple
User={{ xray_user }}
Group={{ xray_group }}

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
RestrictSUIDSGID=true

ExecStartPre=/usr/bin/test -r {{ xray_certs_path }}/fullchain.pem
ExecStartPre=/usr/bin/test -r {{ xray_certs_path }}/privkey.pem
ExecStartPre=/bin/sh -c '/usr/bin/openssl x509 -checkend 86400 -noout -in {{ xray_certs_path }}/fullchain.pem'

ExecStart={{ xray_bin_path }} run -config {{ xray_config_path }}/config.json
Restart=on-failure

LimitNPROC=10000
LimitNOFILE=1000000

LogLevelMax=4

[Install]
WantedBy=multi-user.target