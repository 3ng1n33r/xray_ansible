{
    "log": {
        "dnsLog": false,
        "loglevel": "warning"
    },
    "api": {
      "tag": "api",
      "listen": "127.0.0.1:8080",
      "services": ["StatsService"]
    },
    "stats": {},
    "policy": {
        "levels": {
            "0": {
            "statsUserUplink": true,
            "statsUserDownlink": true,
            "statsUserOnline": true
            }
        },
        "system": {
            "statsInboundUplink": true,
            "statsInboundDownlink": true,
            "statsOutboundUplink": true,
            "statsOutboundDownlink": true
        }
    },
    "inbounds": [
        {
            "listen":"0.0.0.0",
            "port": "{{ xray_port }}", 
            "protocol": "vless",
            "tag": "reality-in",
            "settings": {
                "clients": [
                {% for i in range(xray_clients) %}
                {
                    "id": "{{ uuid_files.results[i].stdout }}",
                    "level": 0,
                    "email": "user{{ i }}@example.com"
                }{% if not loop.last %},{% endif %}
                {% endfor %}
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "xhttp",
                "xhttpSettings": {
                    "path": "/x1"
                },
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "{{ xray_realityDomain }}:443",
                    "serverNames": [
                        "{{ xray_realityDomain }}"
                    ],
                    "privateKey": "{{ privateKey.stdout }}",
                    "shortIds": [
                        "{{ shortId.stdout }}"
                    ]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "routeOnly": true
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct"
        },
	    {
            "protocol": "blackhole",
            "tag": "block"
        }
    ],
    "routing": {
      "rules": [
        {
          "type": "field",
          "protocol": "bittorrent",
          "outboundTag": "block"
        },
        {
            "domain": [
                "geosite:category-gov-ru"
            ],
            "outboundTag": "block"
        }
    ],
    "domainStrategy": "IPIfNonMatch"
  }
}
